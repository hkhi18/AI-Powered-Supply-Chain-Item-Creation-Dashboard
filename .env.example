# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) in ./pgdata
# Set it to use a real PostgreSQL server instead, e.g.:
# DATABASE_URL=postgres://postgres:password@localhost:5432/scm_items
DATABASE_URL=

# Chatbot (Gemini). Copy this file to .env.local and paste your key.
GEMINI_API_KEY=

# Optional: GEMINI_MODEL=gemini-flash-lite-latest
